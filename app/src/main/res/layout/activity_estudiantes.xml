<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de Estudiantes"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Administra los estudiantes registrados"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevoEstudiante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo estudiante"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estudiantes registrados"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp"/>

    <ListView
        android:id="@+id/listViewEstudiantes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp"/>

    <TextView
        android:id="@+id/tvSinEstudiantes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay estudiantes registrados"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:padding="20dp"
        android:visibility="gone"/>

</LinearLayout>
