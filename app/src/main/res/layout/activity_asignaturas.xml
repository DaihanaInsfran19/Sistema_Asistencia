<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="20dp">
    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de Asignaturas"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"/>

    <!-- Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Administra las asignaturas registradas"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp"/>

    <!-- Botón para crear -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevaAsignatura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nueva Asignatura"
        android:layout_marginBottom="24dp"/>

    <!-- Título del listado -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Asignaturas registradas"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp"/>

    <!-- Lista de asignaturas -->
    <ListView
        android:id="@+id/listViewAsignaturas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp"/>

    <!-- Mensaje cuando no hay registros -->
    <TextView
        android:id="@+id/tvSinAsignaturas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay asignaturas registradas"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:padding="20dp"
        android:visibility="gone"/>

</LinearLayout>
